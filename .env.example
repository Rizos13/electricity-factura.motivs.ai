MOTIVS_APP_NAME=electricity-factura.motivs.ai
MOTIVS_ENVIRONMENT=development
MOTIVS_LOG_LEVEL=INFO

MOTIVS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MOTIVS_TRUSTED_HOSTS=*

MOTIVS_TENANT_SLUG=factura-es
MOTIVS_HMAC_KEY=dev-only-replace-in-prod

MOTIVS_FACTURA_CONTRACT_PATH=backend/contracts/factura_electricidad.yaml
MOTIVS_OFERTAS_CONTRACT_PATH=backend/contracts/oferta_electricidad.yaml

MOTIVS_REGIONS=barcelona,girona,lleida,tarragona

MOTIVS_REDIS_URL=
MOTIVS_PROFILE_REDIS_TTL=1800
MOTIVS_UPLOAD_DISK_TTL=300

MOTIVS_OFFERS_BUCKET=motivs-factura-offers
MOTIVS_LANCEDB_URI=backend/artifacts/lancedb
MOTIVS_OFFERS_TABLE=offers

MOTIVS_CNMC_SCRAPE_INTERVAL=86400

MOTIVS_BLURB_ENABLED=false

